# ==============================================================================
# Infisical Environment Variables Template
# ==============================================================================

# Keys
# Required: 32-byte hex key for platform encryption/decryption operations.
# You can generate one with: openssl rand -hex 16
# WARNING: DO NOT CHANGE THIS KEY AFTER RUNNING THE CONTAINER AS IT WILL RENDER
# CURRENT DATA UNREADABLE.
ENCRYPTION_KEY=f13dbc92aaaf86fa7cb0ed8ac3265f47

# JWT Authentication
# Required: Secret key to sign JWT tokens.
# You can generate one with: openssl rand -base64 32
AUTH_SECRET=5lrMXKKWCVocS/uerPsl7V+TX/aaUaI7iDkgl3tSmLE=

# Postgres Database Credentials
POSTGRES_USER=infisical
POSTGRES_PASSWORD=infisical_secure_pass_change_me
POSTGRES_DB=infisical

# DB Connection URI (referenced by the backend service)
DB_CONNECTION_URI=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis Connection URL
REDIS_URL=redis://redis:6379

# Website External URL
# Required: Set to the address users access Infisical on (e.g. http://localhost:8080 or https://infisical.yourdomain.com)
SITE_URL=http://localhost:8081
# Required for Traefik routing
INFISICAL_HOST=infisical.yourdomain.com

# Mail/SMTP Settings (Optional, required for invite emails, alerts, etc.)
SMTP_HOST=
SMTP_PORT=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_USERNAME=
SMTP_PASSWORD=

# CI/CD Integrations (Optional)
CLIENT_ID_GITHUB=
CLIENT_ID_GITHUB_APP=
CLIENT_SLUG_GITHUB_APP=
CLIENT_SECRET_GITHUB=
CLIENT_SECRET_GITHUB_APP=
CLIENT_ID_GITLAB=
CLIENT_SECRET_GITLAB=
CLIENT_PRIVATE_KEY_GITHUB_APP=
CLIENT_APP_ID_GITHUB_APP=

# SSO / Login Integrations (Optional)
CLIENT_ID_GOOGLE_LOGIN=
CLIENT_SECRET_GOOGLE_LOGIN=
CLIENT_ID_GITHUB_LOGIN=
CLIENT_SECRET_GITHUB_LOGIN=
CLIENT_ID_GITLAB_LOGIN=
CLIENT_SECRET_GITLAB_LOGIN=

# Captcha Configuration (Optional)
CAPTCHA_SECRET=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# OpenTelemetry Settings
OTEL_TELEMETRY_COLLECTION_ENABLED=false
OTEL_EXPORT_TYPE=prometheus
OTEL_EXPORT_OTLP_ENDPOINT=
