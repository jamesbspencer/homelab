model:
  default: gemma4:12b
  provider: custom
  base_url: http://litellm:4000/v1
  api_key: ${CUSTOM_API_KEY}
  context_length: 65536
  ollama_num_ctx: 65536
terminal:
  backend: docker
  timeout: 180
  docker_image: hermes-terminal:latest
  lifetime_seconds: 300
  docker_mount_cwd_to_workspace: true
  docker_volumes:
    - /data/homelab/hermes/workspace:/workspace
    - /data/repos:/data/repos
  singularity_image: docker://hermes-terminal:latest
  modal_image: hermes-terminal:latest
  daytona_image: hermes-terminal:latest
  docker_forward_env:
    - BWS_ACCESS_TOKEN
    - BWS_PROJECT_ID
web:
  search_backend: searxng
  extract_backend: firecrawl
auxiliary:
  curator:
    provider: litellm
    model: gemma4:12b
  background_review:
    enabled: false
    provider: litellm
    model: gemma4:12b
    max_input_tokens: 600000
dashboard:
  theme: default
  oauth:
    self_hosted:
      issuer: ${HERMES_DASHBOARD_OIDC_ISSUER}
      client_id: ${HERMES_DASHBOARD_OIDC_CLIENT_ID}
      client_secret: ${HERMES_DASHBOARD_OIDC_CLIENT_SECRET}
      scopes: openid profile email
memory:
  provider: hindsight
compression:
  enabled: true
  threshold: 0.60
  target_ratio: 0.25
  protect_last_n: 12
  proactive_prune_tokens: 12000
  proactive_prune_min_result_chars: 4000
skills:
  creation_nudge_interval: 5
  external_dirs:
    - /data/repos/ai-skills/skills
  disabled:
    - airtable
    - arxiv
    - baoyu-infographic
    - box
    - claude-code
    - claude-design
    - codex
    - competitor-news-monitor
    - computer-use
    - dogfood
    - grounded-citations
    - himalaya
    - llama-cpp
    - notion
    - obsidian
    - research-paper-writing
    - songwriting-and-ai-music
    - teams-meeting-pipeline
    - youtube-content
curator:
  enabled: true
  interval_hours: 168
  consolidate: true
  stale_days: 30
  archive_days: 90
_config_version: 46
custom_providers:
  - name: litellm
    base_url: http://litellm:4000/v1
    api_key: ${CUSTOM_API_KEY}
    context_length: 65536
    models:
      qwen2.5:14b: {}
      default: {}
      nomic-embed-text: {}
      groq/llama-3.3-70b-versatile: {}
      openrouter/auto: {}
      deepseek/deepseek-chat: {}
      gemma4:12b: {}
    models_discovered: true
platforms:
  api_server:
    enabled: true
platform_toolsets:
  cli:
    - clarify
    - code_execution
    - connections
    - file
    - memory
    - session_search
    - skills
    - terminal
    - todo
    - web
  api_server:
    - clarify
    - code_execution
    - connections
    - file
    - memory
    - session_search
    - skills
    - terminal
    - todo
    - web
  gateway:
    - clarify
    - code_execution
    - connections
    - file
    - memory
    - session_search
    - skills
    - terminal
    - todo
    - web
known_plugin_toolsets:
  cli: []
known_builtin_toolsets:
  cli:
    - clarify
    - code_execution
    - connections
    - file
    - memory
    - session_search
    - skills
    - terminal
    - todo
    - web
secrets:
  bitwarden:
    enabled: true
    access_token_env: BWS_ACCESS_TOKEN
    project_id: ${BWS_PROJECT_ID}
    server_url: https://vault.bitwarden.com

# ── Security ──────────────────────────────────────────────────────────
# Secret redaction is ON by default — strings that look like API keys,
# tokens, and passwords are masked in tool output, logs, and chat
# responses before the model or user ever sees them. Set redact_secrets
# to false to disable (e.g. when developing the redactor itself).
# tirith pre-exec scanning is enabled by default when the tirith binary
# is available. Configure via security.tirith_* keys or env vars
# (TIRITH_ENABLED, TIRITH_BIN, TIRITH_TIMEOUT, TIRITH_FAIL_OPEN).
#
# security:
#   redact_secrets: true
#   tirith_enabled: true
#   tirith_path: "tirith"
#   tirith_timeout: 5
#   tirith_fail_open: true

# ── Fallback Model ────────────────────────────────────────────────────
# Automatic provider failover when primary is unavailable.
# Uncomment and configure to enable. Triggers on rate limits (429),
# overload (529), service errors (503), or connection failures.
#
# Supported providers:
#   openrouter   (OPENROUTER_API_KEY)  — routes to any model
#   openai-codex (OAuth — hermes auth) — OpenAI Codex
#   nous         (OAuth — hermes auth) — Nous Portal
#   zai          (ZAI_API_KEY)         — Z.AI / GLM
#   kimi-coding  (KIMI_API_KEY)        — Kimi / Moonshot
#   kimi-coding-cn (KIMI_CN_API_KEY)   — Kimi / Moonshot (China)
#   minimax      (MINIMAX_API_KEY)     — MiniMax
#   minimax-cn   (MINIMAX_CN_API_KEY)  — MiniMax (China)
#   bedrock      (AWS IAM / boto3)     — AWS Bedrock (Converse API)
#
# For custom OpenAI-compatible endpoints, add base_url and key_env.
#
# fallback_model:
#   provider: openrouter
#   model: anthropic/claude-sonnet-4
gateway:
  multiplex_profiles: true
plugins:
  enabled:
    - hindsight
  disabled: []
mcp_servers:
  memlord:
    headers:
      Authorization: Bearer ${MCP_MEMLORD_API_KEY}
    url: http://memlord:8000/mcp
