# Environment variables containing credentials/secrets
.env

# Traefik state and SSL certificates
traefik/acme.json
traefik/certs/*
!traefik/certs/.gitkeep
traefik/logs/*
!traefik/logs/.gitkeep
traefik/crowdsec_bouncer_key

# Postgres raw database data
postgres
postgres/*

# pgvector standalone data
pgvector/data
pgvector/data/*
!pgvector/data/.gitkeep

# Ollama models, caches, and key pairs
ollama/*
!ollama/.gitkeep
!ollama/Modelfile*


# Open WebUI state (sqlite databases, vector db, uploads, cache)
open-webui/*
!open-webui/.gitkeep

# Valkey state/data
valkey/*
!valkey/.gitkeep


# Open Terminal state/home directory
open-terminal/*
!open-terminal/.gitkeep

# SearXNG data/cache
searxng/config/settings.yml

# Hermes data
hermes/*
!hermes/config.yaml
!hermes/SOUL.md
!hermes/scripts/
hermes/scripts/*
!hermes/scripts/hermes_mcp_server.py
!hermes/init/
hermes/init/*
!hermes/init/03-mcp-server.sh
!hermes/hindsight/
hermes/hindsight/*
!hermes/hindsight/config.json

# NuQ Postgres data
nuq-postgres
nuq-postgres/*

# CrowdSec data and generated configuration
crowdsec/data/*
!crowdsec/data/.gitkeep
crowdsec/config/*
!crowdsec/config/acquis.d/
!crowdsec/config/acquis.d/*


