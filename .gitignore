# Authentik runtime media and templates
authentik/media/*
!authentik/media/.gitkeep
authentik/custom-templates/*
!authentik/custom-templates/.gitkeep


# ntfy runtime data and message cache
ntfy/data/*
!ntfy/data/.gitkeep
ntfy/cache/*
!ntfy/cache/.gitkeep

# Gitea repository and runtime data
gitea/*
!gitea/.gitkeep

# Homepage runtime logs
homepage/config/logs/*
!homepage/config/logs/.gitkeep

# MoMoE cloned source tree and runtime model/pack data
momoe/src/
momoe/data/*
!momoe/data/.gitkeep
!momoe/docker-entrypoint.sh

# OpenBao Raft Storage & Vault Data
openbao/data/*
!openbao/data/.gitkeep
openbao/unseal.keys
openbao/*.keys

# Open WebUI runtime data and uploads
