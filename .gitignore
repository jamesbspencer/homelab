traefik/crowdsec_bouncer_key

# Postgres raw database data
postgres
postgres/*

# pgvector standalone data & archives
pgvector/data
pgvector/data/*
!pgvector/data/.gitkeep
pgvector/archives/*
!pgvector/archives/.gitkeep

# System & Service Archives
archives/*
*.tar.gz

# Llama.cpp models and runtime caches
llama/models/*
!llama/models/.gitkeep

# Ollama models, caches, and key pairs
ollama/*
!ollama/.gitkeep
!ollama/Modelfile*


# Valkey state/data
valkey/*
!valkey/.gitkeep

# SearXNG data/cache
searxng/config/settings.yml

# NuQ Postgres data
nuq-postgres
nuq-postgres/*

# CrowdSec data and generated configuration
crowdsec/data/*
!crowdsec/data/.gitkeep
crowdsec/config/*
!crowdsec/config/acquis.d/
!crowdsec/config/acquis.d/*
!crowdsec/config/profiles.yaml
!crowdsec/config/notifications/
crowdsec/config/notifications/*
