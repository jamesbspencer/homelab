# Open WebUI Secret Key
OPENWEBUI_SECRET_KEY=your_openwebui_secret_key_here

# Legacy Open WebUI Postgres Configuration
POSTGRES_VERSION=pg16
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=openwebui

# Dedicated pgvector Instance (Hindsight & Future Services)
PGVECTOR_VERSION=pg16
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=your_secure_pgvector_admin_password_here
PGVECTOR_DB=postgres

# Hindsight Database & Role (auto-provisioned in pgvector)
HINDSIGHT_POSTGRES_DB=hindsight
HINDSIGHT_POSTGRES_USER=hindsight
HINDSIGHT_POSTGRES_PASSWORD=your_secure_hindsight_password_here

# Hindsight Long-Term Memory Engine
HINDSIGHT_VERSION=latest
HINDSIGHT_LLM_PROVIDER=ollama
HINDSIGHT_LLM_BASE_URL=http://ollama:11434/v1
HINDSIGHT_LLM_MODEL=qwen2.5:14b
HINDSIGHT_LLM_MAX_CONCURRENT=1
HINDSIGHT_MODE=local_external
HINDSIGHT_API_URL=http://hindsight:8888
HINDSIGHT_BANK_ID=hermes

# Open Terminal Configuration
OPEN_TERMINAL_API_KEY=your_open_terminal_api_key_here

# Hermes Configuration
HERMES_API_KEY=your_hermes_api_key_here
HERMES_MCP_KEY=your_hermes_mcp_key_here
HERMES_PROVIDER=custom
CUSTOM_BASE_URL=http://litellm:4000/v1
HERMES_MODEL=qwen2.5:14b
HERMES_DASHBOARD=1
API_SERVER_ENABLED=true
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=spencer
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=your_scrypt_password_hash_here
PUID=1000
PGID=1000
BROWSER_CDP_URL=ws://browserless:3000
GATEWAY_ALLOW_ALL_USERS=true
HERMES_TERMINAL_ENV=docker
HERMES_TERMINAL_DOCKER_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20

# SearXNG Integration
SEARXNG_URL=http://searxng:8080

# Firecrawl Configuration (Internal)
FIRECRAWL_API_URL=http://firecrawl:3002
FIRECRAWL_API_KEY=
USE_DB_AUTHENTICATION=false
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=10
FIRECRAWL_POSTGRES_USER=postgres
FIRECRAWL_POSTGRES_PASSWORD=your_secure_firecrawl_postgres_password_here
FIRECRAWL_POSTGRES_DB=postgres

# LiteLLM Proxy Configuration
LITELLM_MASTER_KEY=sk-spencer-your_master_key_here
LITELLM_POSTGRES_DB=litellm
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=your_secure_litellm_password_here

# Optional Cloud LLM Provider API Keys (for LiteLLM routing/fallback)
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# CrowdSec Configuration
CROWDSEC_BOUNCER_KEY=your_crowdsec_bouncer_key_here

