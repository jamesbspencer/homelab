# Open WebUI Secret Key
OPENWEBUI_SECRET_KEY=your_openwebui_secret_key_here

# PGVECTOR Configuration
POSTGRES_VERSION=pg16
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=openwebui

# Open Terminal Configuration
OPEN_TERMINAL_API_KEY=your_open_terminal_api_key_here

# Hermes Configuration
HERMES_API_KEY=your_hermes_api_key_here
HERMES_PROVIDER=custom
CUSTOM_BASE_URL=http://ollama:11434/v1
HERMES_MODEL=qwen3.5:9b
HERMES_DASHBOARD=1
API_SERVER_ENABLED=true
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=spencer
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=your_scrypt_password_hash_here
PUID=1000
PGID=1000
BROWSER_CDP_URL=ws://browserless:3000
GATEWAY_ALLOW_ALL_USERS=true

# SearXNG Integration
SEARXNG_URL=http://searxng:8080

# Firecrawl Configuration (Internal)
FIRECRAWL_API_URL=http://firecrawl:3002
FIRECRAWL_API_KEY=
USE_DB_AUTHENTICATION=false
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=10
FIRECRAWL_POSTGRES_USER=postgres
FIRECRAWL_POSTGRES_PASSWORD=your_secure_firecrawl_postgres_password_here
FIRECRAWL_POSTGRES_DB=postgres
