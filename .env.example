# Open WebUI Secret Key
OPENWEBUI_SECRET_KEY=your_openwebui_secret_key_here

# Legacy Open WebUI Postgres Configuration
POSTGRES_VERSION=pg16
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=openwebui

# Dedicated pgvector Instance (Hindsight & Future Services)
PGVECTOR_VERSION=pg16
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=your_secure_pgvector_admin_password_here
PGVECTOR_DB=postgres

# Hindsight Database & Role (auto-provisioned in pgvector)
HINDSIGHT_POSTGRES_DB=hindsight
HINDSIGHT_POSTGRES_USER=hindsight
HINDSIGHT_POSTGRES_PASSWORD=your_secure_hindsight_password_here

# Hindsight Long-Term Memory Engine
HINDSIGHT_VERSION=latest
HINDSIGHT_LLM_PROVIDER=ollama
HINDSIGHT_LLM_BASE_URL=http://ollama:11434/v1
HINDSIGHT_LLM_MODEL=qwen2.5:14b
HINDSIGHT_LLM_MAX_CONCURRENT=1
HINDSIGHT_MODE=local_external
HINDSIGHT_API_URL=http://hindsight:8888
HINDSIGHT_BANK_ID=hermes

# Open Terminal Configuration
OPEN_TERMINAL_API_KEY=your_open_terminal_api_key_here

# Hermes Configuration
HERMES_API_KEY=your_hermes_api_key_here
HERMES_MCP_KEY=your_hermes_mcp_key_here
HERMES_PROVIDER=custom
CUSTOM_BASE_URL=http://litellm:4000/v1
HERMES_MODEL=qwen2.5:14b
HERMES_DASHBOARD=1
API_SERVER_ENABLED=true
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=spencer
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=your_scrypt_password_hash_here
PUID=1000
PGID=1000
BROWSER_CDP_URL=ws://browserless:3000
GATEWAY_ALLOW_ALL_USERS=true
HERMES_TERMINAL_ENV=docker
HERMES_TERMINAL_DOCKER_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20

# SearXNG Integration
SEARXNG_URL=http://searxng:8080

# Firecrawl Configuration (Internal)
FIRECRAWL_API_URL=http://firecrawl:3002
FIRECRAWL_API_KEY=
USE_DB_AUTHENTICATION=false
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=10
FIRECRAWL_POSTGRES_USER=postgres
FIRECRAWL_POSTGRES_PASSWORD=your_secure_firecrawl_postgres_password_here
FIRECRAWL_POSTGRES_DB=postgres

# LiteLLM Proxy Configuration
LITELLM_MASTER_KEY=sk-spencer-your_master_key_here
LITELLM_POSTGRES_DB=litellm
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=your_secure_litellm_password_here

# Optional Cloud LLM Provider API Keys (for LiteLLM routing/fallback)
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# CrowdSec Configuration
CROWDSEC_BOUNCER_KEY=your_crowdsec_bouncer_key_here

# Let's Encrypt / ACME Public Ingress
ACME_EMAIL=admin@example.com
HERMES_PUBLIC_DOMAIN=hermes.example.com
SSO_PUBLIC_DOMAIN=sso.example.com

# Authentik Centralized IAM & SSO
AUTHENTIK_VERSION=2026.8.1
AUTHENTIK_SECRET_KEY=your_authentik_secret_key_here
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=your_secure_authentik_postgres_password_here

# Hermes Built-in OIDC SSO Integration
HERMES_DASHBOARD_OIDC_ISSUER=https://sso.example.com/application/o/hermes/
HERMES_DASHBOARD_OIDC_CLIENT_ID=hermes
HERMES_DASHBOARD_OIDC_CLIENT_SECRET=your_hermes_oidc_client_secret_here
HERMES_DASHBOARD_PUBLIC_URL=https://hermes.example.com

# LiteLLM Built-in OIDC SSO Integration
LITELLM_OIDC_CLIENT_ID=litellm
LITELLM_OIDC_CLIENT_SECRET=your_litellm_oidc_client_secret_here

# Dozzle Container Log Viewer
DOZZLE_VERSION=latest

# Infisical Agent Vault Configuration
AGENTVAULT_VERSION=latest
AGENTVAULT_POSTGRES_DB=agentvault
AGENTVAULT_POSTGRES_USER=agentvault
AGENTVAULT_POSTGRES_PASSWORD=your_secure_agentvault_postgres_password_here
AGENT_VAULT_MASTER_PASSWORD=your_32_byte_hex_master_password_here
AGENT_VAULT_ADDR=https://vault.spencer.lan
AGENT_VAULT_ALLOW_PRIVATE_RANGES=true

# Agent Vault Proxy & Credential Brokering
HERMES_AGENT_VAULT_TOKEN=your_agent_vault_token_here
HERMES_HTTP_PROXY=http://${HERMES_AGENT_VAULT_TOKEN}@agent-vault:14322
HERMES_HTTPS_PROXY=http://${HERMES_AGENT_VAULT_TOKEN}@agent-vault:14322
HERMES_NO_PROXY=localhost,127.0.0.1,ollama,litellm,searxng,firecrawl,hindsight,authentik-server,pgvector,valkey,rabbitmq,nuq-postgres,playwright-service,agent-vault,traefik,dozzle,${SSO_PUBLIC_DOMAIN},${HERMES_PUBLIC_DOMAIN},.spencer.lan

# Optional granular Agent Vault tokens for downstream egress services (defaults to HERMES_AGENT_VAULT_TOKEN if omitted)
# LITELLM_AGENT_VAULT_TOKEN=
# SEARXNG_AGENT_VAULT_TOKEN=
# FIRECRAWL_AGENT_VAULT_TOKEN=

# Placeholder Credentials Brokered via Agent Vault
# ANTHROPIC_API_KEY=__anthropic_api_key__
# OPENAI_API_KEY=__openai_api_key__
OPENROUTER_API_KEY=OPENROUTER_API_KEY
# GROQ_API_KEY=__groq_api_key__
# DEEPSEEK_API_KEY=__deepseek_api_key__
# GITHUB_TOKEN=__github_token__
# TELEGRAM_BOT_TOKEN=__telegram_bot_token__


