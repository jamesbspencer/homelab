# Open WebUI Secret Key
OPENWEBUI_SECRET_KEY=your_openwebui_secret_key_here

# Legacy Open WebUI Postgres Configuration
POSTGRES_VERSION=pg16
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=openwebui

# Dedicated pgvector Instance (LiteLLM, Open WebUI, Authentik, Gitea)
PGVECTOR_VERSION=pg16
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=your_secure_pgvector_admin_password_here
PGVECTOR_DB=postgres

# System Permissions
PUID=1000
PGID=1000

# SearXNG Integration
SEARXNG_URL=http://searxng:8080

# Firecrawl Configuration (Internal)
FIRECRAWL_API_URL=http://firecrawl:3002
FIRECRAWL_API_KEY=homelab-local
USE_DB_AUTHENTICATION=false
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=10
FIRECRAWL_POSTGRES_USER=postgres
FIRECRAWL_POSTGRES_PASSWORD=your_secure_firecrawl_postgres_password_here
FIRECRAWL_POSTGRES_DB=postgres

# OmniRoute AI Gateway Configuration (Replaces LiteLLM)
OMNIROUTE_JWT_SECRET=your_omniroute_jwt_secret_here
OMNIROUTE_API_KEY_SECRET=your_omniroute_aes_api_key_secret_32_chars_here
OMNIROUTE_INITIAL_PASSWORD=your_secure_omniroute_admin_password_here
OMNIROUTE_MASTER_KEY=sk-spencer-your_master_key_here

# Deprecated: LiteLLM Proxy Configuration (Archived)
# LITELLM_MASTER_KEY=sk-spencer-your_master_key_here
# LITELLM_POSTGRES_DB=litellm
# LITELLM_POSTGRES_USER=litellm
# LITELLM_POSTGRES_PASSWORD=your_secure_litellm_password_here

# Optional Cloud LLM Provider API Keys (for LiteLLM routing/fallback)
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# CrowdSec Configuration
CROWDSEC_BOUNCER_KEY=your_crowdsec_bouncer_key_here

# Let's Encrypt / ACME Public Ingress
ACME_EMAIL=admin@example.com
SSO_PUBLIC_DOMAIN=sso.example.com
NTFY_PUBLIC_DOMAIN=push.example.com

# Authentik Centralized IAM & SSO
AUTHENTIK_VERSION=2026.8.1
AUTHENTIK_SECRET_KEY=your_authentik_secret_key_here
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=your_secure_authentik_postgres_password_here

# LiteLLM Built-in OIDC SSO Integration
LITELLM_OIDC_CLIENT_ID=litellm
LITELLM_OIDC_CLIENT_SECRET=your_litellm_oidc_client_secret_here

# Dozzle Container Log Viewer
DOZZLE_VERSION=latest

# Glances System & GPU Hardware Telemetry
GLANCES_VERSION=ubuntu-latest-full

# ntfy Push Notification Gateway
NTFY_VERSION=latest
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh

# Gitea Git Platform
GITEA_VERSION=latest
GITEA_POSTGRES_DB=gitea
GITEA_POSTGRES_USER=gitea
GITEA_POSTGRES_PASSWORD=your_secure_gitea_postgres_password_here
GITEA_PUBLIC_DOMAIN=git.example.com
GITEA_OIDC_CLIENT_ID=gitea
GITEA_OIDC_CLIENT_SECRET=your_gitea_oidc_client_secret_here

# Homepage Dashboard
HOMEPAGE_VERSION=latest
HOMEPAGE_PUBLIC_DOMAIN=home.example.com
DOCKER_GID=983
HOMEPAGE_VAR_AUTHENTIK_TOKEN=
HOMEPAGE_VAR_GITEA_TOKEN=

# MoMoE Hybrid Mixture-of-Experts Inference Engine
MOMOE_FAMILY=ornith
MOMOE_MODEL=IQ4_XS
MOMOE_CONTEXT=65536
MOMOE_KV_STREAMING=on
MOMOE_VISION=no
MOMOE_VRAM_RESERVE_MIB=2560
MOMOE_API_KEY=your_secure_momoe_api_key_here

# OpenBao Secrets & Encryption Management Server
OPENBAO_VERSION=latest
# Note: For automated unsealing on boot, add your Shamir unseal keys to .env.passwords:
# unseal_key_1=your_unseal_key_1_here
# unseal_key_2=your_unseal_key_2_here
# unseal_key_3=your_unseal_key_3_here

# Open WebUI Generative AI Chat Interface
OPENWEBUI_VERSION=main
OPENWEBUI_SECRET_KEY=your_secure_openwebui_secret_key_here
OPENWEBUI_POSTGRES_DB=openwebui
OPENWEBUI_KNOWLEDGE_POSTGRES_DB=openwebui_knowledge
OPENWEBUI_POSTGRES_USER=openwebui
OPENWEBUI_POSTGRES_PASSWORD=your_secure_openwebui_postgres_password_here
OPENWEBUI_PUBLIC_DOMAIN=ai.example.com
ENABLE_SIGNUP=False
ENABLE_VALVE_ENCRYPTION=True

# Open Terminal Sandbox & Computer Substrate for Open WebUI
OPEN_TERMINAL_VERSION=latest
OPEN_TERMINAL_API_KEY=your_secure_open_terminal_api_key_here
OPEN_TERMINAL_MAX_SESSIONS=16
GH_CLI_VERSION=2.103.3
GITEA_CLI_VERSION=0.1.0
TEA_VERSION=0.16.0
