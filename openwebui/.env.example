# ==============================================================================
# Open WebUI Environment Variables Template
# ==============================================================================

# Open WebUI Ingress Host (for Traefik routing)
# Required: Set to the domain you wish to access Open WebUI on.
OPEN_WEBUI_HOST=openwebui.yourdomain.com

# WebUI Secret Key
# Required: Used to secure user sessions and JWT tokens.
# You can generate a secure random key with: openssl rand -hex 32
WEBUI_SECRET_KEY=your_secure_webui_secret_key_change_me

# Ollama Connection Configuration
# - If using the bundled Ollama container: http://ollama:11434
# - If using a local host-level Ollama service: http://host.docker.internal:11434
# - If using a separate GPU server: http://<gpu_server_ip>:11434
OLLAMA_BASE_URL=http://ollama:11434
